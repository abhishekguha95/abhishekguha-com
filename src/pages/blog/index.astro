---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Blog | Abhishek Guha"
			description="Writing by Abhishek Guha on backend engineering, distributed systems, and software architecture."
		/>
	</head>
	<body>
		<Header />
		<main class="blog-shell">
			<header class="blog-header">
				<p class="eyebrow">Blog</p>
				<h1>First Principles</h1>
				<p>
					Musings on engineering, physics, life and more...				
                    </p>
			</header>

			<section class="post-list" aria-label="Blog posts">
				{
					posts.length === 0 ? (
						<p>No posts published yet.</p>
					) : (
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<div>
											<p class="date">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<h2>{post.data.title}</h2>
											<p>{post.data.description}</p>
										</div>
										<span aria-hidden="true">Read</span>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-shell {
		max-width: 880px;
	}

	.blog-header {
		margin-bottom: 3rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.blog-header h1 {
		max-width: 820px;
		margin-bottom: 1rem;
		font-size: clamp(2.25rem, 7vw, 4rem);
		line-height: 1;
	}

	.blog-header p:not(.eyebrow) {
		max-width: 660px;
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.post-list ul {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-list a {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		justify-content: space-between;
		padding: 1.25rem 0;
		border-top: 1px solid rgb(var(--gray-light));
		text-decoration: none;
	}

	.post-list li:last-child a {
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.post-list h2 {
		margin-bottom: 0.4rem;
		font-size: 1.45rem;
	}

	.post-list p {
		max-width: 680px;
		margin: 0;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
	}

	.post-list .date {
		margin-bottom: 0.25rem;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}

	.post-list span {
		flex: 0 0 auto;
		color: var(--accent);
		font-size: 0.95rem;
	}

	.post-list a:hover h2,
	.post-list a:hover span {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.post-list a {
			display: block;
		}

		.post-list span {
			display: inline-block;
			margin-top: 0.75rem;
		}
	}
</style>
