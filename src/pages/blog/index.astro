---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostCard from '../../components/PostCard.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<SiteLayout title="Writing | Abhishek Guha" description="Notes and essays by Abhishek Guha on backend engineering, distributed systems, and the ideas behind them.">
  <header class="page-intro">
    <p class="eyebrow">The notebook</p>
    <h1>First principles.<br /><em>And second thoughts.</em></h1>
    <p class="lead">Notes on engineering, systems, and understanding things a little better. Written as I build and learn.</p>
  </header>
  <div class="archive-label"><span class="meta-label">All writing <span class="count">{String(posts.length).padStart(2, '0')}</span></span><a class="text-link" href="/rss.xml">Follow via RSS <span aria-hidden="true">↗</span></a></div>
  <section class="posts-grid" aria-label="Published articles">
    {posts.length ? posts.map((post) => <PostCard post={post} headingTag="h2" />) : <p>The first notes are on their way.</p>}
  </section>
  <aside class="archive-note"><span aria-hidden="true">↳</span><p>Good questions tend to lead to more questions.<br />This notebook grows along the way.</p></aside>
</SiteLayout>
<style>
  h1 em { color: var(--accent); }
  .page-intro { max-width: 100%; }
  .archive-label { border-top: 1px solid var(--line); padding: 22px 0; display: flex; align-items: center; justify-content: space-between; gap: 15px; }
  .count { margin-left: 10px; color: var(--muted); }
  .posts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
  .archive-note { display: flex; gap: 20px; color: var(--muted); margin-top: 40px; }
  .archive-note > span { font-size: 24px; color: var(--accent); }
  .archive-note p { font-size: 14px; margin: 0; }
  @media (max-width: 640px) { .posts-grid { grid-template-columns: 1fr; } .page-intro h1 { font-size: clamp(2.6rem, 9vw, 4rem); } }
</style>
