---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found | Abhishek Guha" description="This page could not be found. Find your way back to Abhishek Guha's website.">
  <section class="not-found"><p class="eyebrow">404 / Off the map</p><h1>A small <em>detour.</em></h1><p>This page doesn't seem to exist. Let's get you back to familiar ground.</p><a class="button" href="/">Back to home <span aria-hidden="true">→</span></a></section>
</SiteLayout>
<style>
  .not-found { padding-block: 100px; max-width: 700px; }
  h1 em { color: var(--accent); }
  .not-found > p:not(.eyebrow) { color: var(--muted); margin-block: 25px 30px; max-width: 440px; }
  @media (max-width: 640px) { .not-found { padding-block: 65px; } }
</style>
