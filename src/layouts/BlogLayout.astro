---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Abhishek Guha`} description={description} />
	</head>
	<body>
		<Header />
		<main class="article-shell">
			<article>
				<a class="back-link" href="/blog">Back to blog</a>
				<header class="article-header">
					<p class="eyebrow">Writing</p>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							tags.length > 0 && (
								<ul aria-label="Tags">
									{tags.map((tag) => (
										<li>{tag}</li>
									))}
								</ul>
							)
						}
					</div>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-shell {
		max-width: 760px;
	}

	.back-link {
		display: inline-flex;
		margin-bottom: 2rem;
		font-size: 0.9rem;
		text-decoration: none;
	}

	.article-header {
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.article-header h1 {
		max-width: 12ch;
		margin-bottom: 1rem;
		font-size: clamp(2.4rem, 8vw, 4.4rem);
		line-height: 0.95;
	}

	.description {
		max-width: 680px;
		margin: 0;
		color: rgb(var(--gray-dark));
		font-size: 1.15rem;
		line-height: 1.6;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		align-items: center;
		margin-top: 1.5rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	.meta ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.meta li {
		padding: 0.15rem 0.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-size: 0.8rem;
	}

	.prose {
		padding-top: 2rem;
	}

	.prose :global(h2) {
		margin-top: 2.25rem;
		font-size: 1.65rem;
	}

	.prose :global(p),
	.prose :global(li) {
		color: rgb(var(--gray-dark));
	}
</style>
