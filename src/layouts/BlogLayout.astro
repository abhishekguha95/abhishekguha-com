---
import type { CollectionEntry } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
type Props = CollectionEntry<'blog'>['data'] & { minutes: number; headings: { depth: number; slug: string; text: string }[] };
const { title, description, pubDate, tags, minutes, headings } = Astro.props;
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<SiteLayout title={title + ' | Abhishek Guha'} description={description}>
  <article>
    <header class="article-header">
      <a class="text-link back-link" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
      <p class="eyebrow">From the notebook</p>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <div class="article-meta"><span>Abhishek Guha</span><span class="meta-dot" aria-hidden="true">·</span><FormattedDate date={pubDate} /><span class="meta-dot" aria-hidden="true">·</span><span>{minutes} min read</span></div>
      <ul class="tags" aria-label="Topics">{tags.map((tag) => <li class="pill">{tag}</li>)}</ul>
    </header>
    <div class="reading-layout">
      {contents.length > 0 && <aside class="contents">
        <details open>
          <summary class="meta-label">In this essay</summary>
          <nav aria-label="Table of contents"><ol>{contents.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ol></nav>
        </details>
      </aside>}
      <div class="article-body">
        <div class="prose"><slot /></div>
        <div class="article-end"><span class="end-mark" aria-hidden="true">✳</span><p>Thanks for reading.</p><a class="text-link" href="/blog/">Explore more writing <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </article>
</SiteLayout>
<script>
  const contents = document.querySelector<HTMLDetailsElement>('.contents details');
  const compact = window.matchMedia('(max-width: 900px)');
  if (contents) {
    contents.open = !compact.matches;
    compact.addEventListener('change', () => { contents.open = !compact.matches; });
  }
</script>
<style>
  .article-header { max-width: 850px; margin-inline: auto; padding-block: 45px 40px; border-bottom: 1px solid var(--line); }
  .back-link { color: var(--muted); margin-bottom: 42px; font-size: 13px; }
  .article-header .eyebrow { margin-bottom: 17px; }
  h1 { font-size: clamp(2.7rem, 5.2vw, 4.6rem); max-width: 24ch; letter-spacing: -0.05em; line-height: 1.1; text-wrap: balance; }
  .description { max-width: 700px; color: var(--muted); font-size: 19px; line-height: 1.7; margin: 24px 0; }
  .article-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
  .article-meta > span:first-child { color: var(--ink); }
  .tags { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 7px; }
  .reading-layout { display: grid; grid-template-columns: 180px minmax(0, 720px); justify-content: center; align-items: start; gap: 50px; margin-top: 42px; }
  .contents { position: sticky; top: 35px; padding-top: 6px; }
  .contents summary { color: var(--accent); }
  .contents ol { list-style: none; padding: 0; margin: 20px 0; border-left: 1px solid var(--line); }
  .contents li { padding-left: 15px; margin: 12px 0; line-height: 1.45; }
  .contents a { font-size: 12px; color: var(--muted); text-decoration: none; }
  .contents a:hover { color: var(--accent); }
  .article-body { min-width: 0; }
  .article-end { border-top: 1px solid var(--line); padding-top: 35px; margin-top: 48px; }
  .end-mark { font-size: 35px; color: var(--rust); }
  .article-end p { font-family: var(--serif); font-size: 28px; margin: 10px 0; }
  @media (max-width: 900px) {
    .reading-layout { grid-template-columns: minmax(0, 720px); gap: 28px; }
    .contents { position: static; border-bottom: 1px solid var(--line); padding-bottom: 18px; }
    .contents ol { columns: 2; column-gap: 24px; }
    .contents li { break-inside: avoid; }
  }
  @media (max-width: 640px) {
    .article-header { padding-block: 30px; }
    .back-link { margin-bottom: 30px; }
    h1 { font-size: clamp(2.4rem, 9.5vw, 3.5rem); }
    .description { font-size: 17px; margin-block: 20px; }
    .article-meta { gap: 7px; font-size: 11px; }
    .reading-layout { margin-top: 25px; }
    .contents ol { columns: 1; }
  }
</style>
