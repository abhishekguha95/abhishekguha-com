---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION } from '../consts';
interface Props { title: string; description?: string; mainClass?: string; }
const { title, description = SITE_DESCRIPTION, mainClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={title} description={description} /></head>
  <body>
    <Header />
    <main id="main-content" class:list={['site-main', mainClass]} tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
