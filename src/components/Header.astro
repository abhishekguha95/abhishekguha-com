---
import HeaderLink from './HeaderLink.astro';
const links = [{ href: '/blog/', text: 'Writing' }, { href: '/projects/', text: 'Projects' }, { href: '/about/', text: 'About' }];
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header container">
  <a class="wordmark" href="/" aria-label="Abhishek Guha — home">
    <span class="monogram" aria-hidden="true">ag<span>.</span></span><span>Abhishek Guha</span>
  </a>
  <div class="header-right">
    <nav class="desktop-nav" aria-label="Main navigation">{links.map((link) => <HeaderLink href={link.href}>{link.text}</HeaderLink>)}</nav>
    <button class="theme-toggle" type="button" aria-label="Toggle dark theme" aria-pressed="false" hidden>
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20.3 15.8A8.7 8.7 0 0 1 8.2 3.7a8.8 8.8 0 1 0 12.1 12.1Z" /></svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
    </button>
    <details class="mobile-menu">
      <summary>Menu <span aria-hidden="true">+</span></summary>
      <nav aria-label="Mobile navigation">
        <HeaderLink href="/">Home</HeaderLink>
        {links.map((link) => <HeaderLink href={link.href}>{link.text}</HeaderLink>)}
        <HeaderLink href="/resume/">Resume</HeaderLink>
      </nav>
    </details>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (toggle) {
    toggle.hidden = false;
    toggle.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
    toggle.addEventListener('click', () => {
      const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#171d19' : '#e8ece3');
      toggle.setAttribute('aria-pressed', String(theme === 'dark'));
      try { localStorage.setItem('theme', theme); } catch { /* Theme still works without storage. */ }
    });
  }
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
  document.addEventListener('click', (event) => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
</script>
<style>
  .site-header { height: 100px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); position: relative; z-index: 10; }
  .wordmark { display: flex; gap: 14px; align-items: center; text-decoration: none; font-size: 15px; }
  .monogram { font-family: var(--serif); font-size: 33px; letter-spacing: -3px; line-height: 1; }
  .monogram span { color: var(--rust); }
  .header-right { display: flex; align-items: center; gap: 28px; }
  .desktop-nav { display: flex; align-items: center; gap: 30px; }
  nav :global(a) { position: relative; text-decoration: none; font-size: 14px; color: var(--muted); }
  nav :global(a:hover), nav :global(a.active) { color: var(--ink); }
  .desktop-nav :global(a.active)::after { content: ''; position: absolute; bottom: -9px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); left: calc(50% - 2px); }
  .theme-toggle { border: 1px solid var(--line); border-radius: 50%; width: 40px; height: 40px; background: transparent; display: grid; place-items: center; }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { background: var(--surface); }
  .sun { display: none; }
  :global([data-theme='dark']) .sun { display: block; }
  :global([data-theme='dark']) .moon { display: none; }
  .mobile-menu { display: none; }
  @media (max-width: 640px) {
    .site-header { height: 78px; }
    .wordmark { gap: 10px; font-size: 13px; }
    .monogram { font-size: 30px; }
    .header-right { gap: 14px; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    summary { display: flex; align-items: center; gap: 10px; list-style: none; font-size: 13px; min-height: 44px; }
    summary::-webkit-details-marker { display: none; }
    summary span { font-size: 20px; transition: transform 180ms; }
    details[open] summary span { transform: rotate(45deg); }
    .mobile-menu nav { position: absolute; top: 68px; right: 0; width: min(280px, 100%); padding: 14px 20px; background: var(--surface-raised); border: 1px solid var(--line); border-radius: 4px; box-shadow: 0 12px 32px #0000000d; }
    .mobile-menu nav :global(a) { display: block; padding: 11px 0; }
    .mobile-menu nav :global(a.active) { color: var(--accent); }
    .theme-toggle { width: 36px; height: 36px; }
  }
  @media (max-width: 360px) { .wordmark > span:last-child { max-width: 75px; line-height: 1.25; } }
</style>
